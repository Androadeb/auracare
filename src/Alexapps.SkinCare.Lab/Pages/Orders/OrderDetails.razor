@page "/order-details/{Id}"
@attribute [Authorize(Roles = "LAB")]
@layout MainLayout
@using AgeCalculator;
@inject OrderService OrderService
@inject NotificationService Notification
@inject IJSRuntime JsRuntime

<div class="space-y-6 min-h-screen">

  @if (_orderDetails == null)
  {
    <div class="flex justify-center items-center h-64">
      <div class="animate-spin rounded-full h-14 w-14 border-4 border-orange-300 border-t-transparent"></div>
    </div>
  }
  else
  {
    <h2 class="font-semibold text-2xl text-defaulttextcolor dark:text-defaulttextcolor/70 !mb-1 mt-4">
      View order details
    </h2>
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6 p-4 rounded-md bg-gray-50">
      <div class="flex items-center gap-2">
        <span class="text-sm font-bold text-[#002B49]">Required medical tests:</span>
        <span class="text-sm text-gray-500">@_orderDetails.TestName</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-sm font-bold text-[#002B49]">Order Status:</span>

        @if (Enum.Parse<DiagnosticTestStatus>(_orderDetails.Status) == DiagnosticTestStatus.Requested)
        {
          <span class="px-3 py-1 text-xs font-bold bg-blue-100 text-blue-600 rounded-lg">
            New
          </span>
        }
        else if (Enum.Parse<DiagnosticTestStatus>(_orderDetails.Status) ==
                 DiagnosticTestStatus.ResultReady)
        {
          <span class="px-3 py-1 text-xs font-bold bg-green-100 text-green-600 rounded-lg">
            Result Ready
          </span>
        }
        else if (Enum.Parse<DiagnosticTestStatus>(_orderDetails.Status) ==
                 DiagnosticTestStatus.SampleCollected)
        {
          <span class="px-3 py-1 text-xs font-bold bg-green-100 text-green-600 rounded-lg">
            Sample Collected
          </span>
        }
        else
        {
          <span class="px-3 py-1 text-xs font-bold bg-orange-100 text-orange-600 rounded-lg">
            In Progress
          </span>
        }
      </div>
      <button data-hs-overlay="#status-modal"
              class="bg-[#f1a68e] text-white px-6 py-2 rounded-lg font-bold text-sm shadow-sm hover:bg-[#e0957d] transition-colors">
        Change order status
      </button>
    </div>


    <div class="grid grid-cols-3 items-center justify-between gap-4 mb-6 h-full">
      @* Start Patient Information *@
      <div class="md:col-span-2 p-4 rounded-md bg-gray-50 h-full">
        <h3 class="text-lg font-bold text-[#002B49] mb-4">Patient Information</h3>

        <div class="flex items-center gap-4 mb-6 pb-2 border-b-2 border-gray-300">
          <img src="@_orderDetails.PatientImage" class="w-14 h-14 rounded-full object-cover"/>
          <div>
            <p class="font-bold text-[#002B49]">@_orderDetails.PatientName</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <p class="text-gray-500 text-xs">Age</p>
            <p class="font-bold text-[#002B49]">@CalculateAge(_orderDetails.DateOfBirth) Years</p>
          </div>
          <div>
            <p class="text-gray-500 text-xs">Gender</p>
            <p class="font-bold text-[#002B49]">@_orderDetails.PatientGender</p>
          </div>
          <div>
            <p class="text-gray-500 text-xs">Email</p>
            <p class="font-bold text-[#002B49]">@_orderDetails.PatientEmail</p>
          </div>
          <div>
            <p class="text-gray-500 text-xs">Phone</p>
            <p class="font-bold text-[#002B49]">@_orderDetails.PatientPhone</p>
          </div>
          <div>
            <p class="text-gray-500 text-xs">Address</p>
            <p class="font-bold text-[#002B49]">@_orderDetails.PatientAddress</p>
          </div>
          <div>
            <p class="text-gray-500 text-xs">Service Type</p>
            <p class="font-bold text-[#002B49]">@CurrentServiceType</p>
          </div>
        </div>
      </div>
      @* End Patient Information *@

      @* Start Doctor Information *@
      <div class="md:col-span-1 p-4 rounded-md bg-gray-50 h-full">
        <div class="grid grid-cols-1 gap-4 text-sm">
          <h3 class="text-lg font-bold text-[#002B49]  pb-1 border-b-2 border-gray-300">Doctor Information</h3>
          <div>
            <p class="font-medium text-gray-500 text-xs mb-1">Doctor Name</p>
            <p class="font-bold text-[#002B49] pb-1 border-b-2 border-gray-300">@_orderDetails.DoctorName</p>
          </div>
          <div>
            <p class="font-medium text-gray-500 text-xs mb-1">Specialization</p>
            <p class="font-bold text-[#002B49] pb-1 border-b-2 border-gray-300">@_orderDetails.Specialization</p>
          </div>
          <div>
            <p class=" font-medium text-gray-500 text-xs mb-1">Contact</p>
            <p class="font-bold text-[#002B49] pb-1">@_orderDetails.DoctorContact</p>
          </div>
        </div>
        @* End Doctor Information *@
      </div>
    </div>
    @* Start Test Result upload *@
    <div class="bg-gray-50 rounded-3xl p-6 mb-6 shadow-sm border border-gray-100">
      <h3 class="text-lg font-bold text-[#002B49] mb-4">Results</h3>
      <div
        class="relative border-2 border-dashed border-gray-100 rounded-lg flex flex-col items-center justify-center bg-gray-200 mb-6 p-6">

        <InputFile OnChange="HandleFileSelected" id="fileInput" accept=".pdf,image/*"
                   class="absolute inset-0 opacity-0 cursor-pointer"
                   disabled="@(CurrentStatus != DiagnosticTestStatus.ResultReady)"/>

        <img src="assets/images/icons/upload-folder.svg" class="w-16 mb-4 opacity-80" alt="Upload Folder Icon"/>
        <p class="font-bold text-[#002B49] text-sm">Upload Result</p>
        <p class="text-xs text-gray-500 mt-1">
          Drop files here or click <span class="text-teal-500 font-medium">browse</span> through your machine
        </p>

        @if (_isUploading)
        {
          <div class="flex flex-col justify-center items-center mt-2">
            <div class="mt-2 text-xs text-orange-500 font-bold animate-pulse">Uploading...</div>
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-orange-300 border-t-transparent"></div>
          </div>
        }

      </div>

      @if (_resultFile is not null)
      {
        <div class="space-y-3">
          <div class="flex items-center justify-between p-4 border border-gray-100 rounded-2xl">
            <div class="flex items-center gap-3">
              <div class="p-2 bg-orange-100 rounded-lg">
                <img src="assets/images/icons/ic-document.svg" alt="file icon">
              </div>
              <div>
                <p class="text-xs font-bold text-[#002B49]">@_resultFile?.ResultFileName</p>
                <p class="text-[10px] text-gray-500">@DateTime.UtcNow</p>
              </div>
            </div>
            <button data-hs-overlay="#preview-modal"
                    class="flex items-center justify-center gap-2 px-4 py-1.5 border border-[#f1a68e] text-[#f1a68e] text-xs font-bold rounded-lg hover:bg-orange-50 transition-colors">
              <img src="assets/images/icons/eye.svg" alt="eye icon" class="w-5 h-5"> Preview
            </button>
          </div>
        </div>
      }
    </div>
    @* End Test Result upload *@


    <div class="grid grid-cols-3 items-center justify-between gap-4 mb-6 pb-4 h-full">

      <div class="md:col-span-2 bg-white rounded-md p-6 shadow-sm border border-gray-100 h-full">
        <h3 class="text-lg font-bold text-[#002B49] mb-6">Order Status</h3>
        <StatusTimeline>
          <StatusItem Label="Order New" Time="Jan 14, 2026 - 9:00 AM"
                      IsActive="@(CurrentStatus >= DiagnosticTestStatus.Requested)"/>
          <StatusItem Label="In Progress" Time="@(CurrentStatus >= DiagnosticTestStatus.InProgress ? "Jan 14, 2026" : "")"
                      IsActive="@(CurrentStatus >= DiagnosticTestStatus.InProgress)"/>
          <StatusItem Label="Sample Taken"
                      Time="@(CurrentStatus >= DiagnosticTestStatus.SampleCollected ? "Jan 15, 2026" : "")"
                      IsActive="@(CurrentStatus >= DiagnosticTestStatus.SampleCollected)"/>
          <StatusItem Label="Result Ready"
                      Time="@(CurrentStatus >= DiagnosticTestStatus.ResultReady ? "Jan 15, 2026" : "")"
                      IsActive="@(CurrentStatus >= DiagnosticTestStatus.ResultReady)"/>
          <StatusItem Label="Sent To Doctor" IsActive="false"/>
        </StatusTimeline>
      </div>

      <div
        class="md:col-span-1 bg-white rounded-md p-6 shadow-sm border border-gray-100 flex flex-col items-center h-full">
        <h3 class="text-lg font-bold text-[#002B49] w-full mb-4">Order QR Code</h3>
        <div class="p-4 border border-gray-100 rounded-2xl mb-4">
          <img src="assets/images/icons/qr-sample.svg" class=""/>
        </div>
        <p class="text-[10px] text-gray-500">Scan This QR Code To Track Order Status</p>
      </div>
    </div>


    @* Start Status Modal *@
    <div id="status-modal"
         class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none">
      <div
        class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto min-h-[calc(100%-3.5rem)] flex items-center">
        <div class="w-full flex flex-col bg-white border shadow-sm rounded-3xl pointer-events-auto p-6">
          <h3 class="text-xl font-bold text-[#002B49] mb-8">Change order status</h3>

          <div class="flex items-center gap-4 mb-10">
            <label class="text-sm font-bold text-[#002B49] whitespace-nowrap">New order status</label>
            <div class="relative w-full">
              <select @bind="_selectedStatus"
                      class="w-full bg-gray-50 border-none rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-[#f1a68e] appearance-none cursor-pointer">
                @foreach (var status in Enum.GetValues<DiagnosticTestStatus>())
                {
                  <option value="@status">@status</option>
                }
              </select>
              <div class="absolute inset-y-0 end-0 flex items-center px-3 pointer-events-none text-gray-400">
                <i class="bi bi-chevron-down text-xs"></i>
              </div>
            </div>
          </div>

          <div class="flex justify-end items-center gap-3">
            <button type="button"
                    class="px-8 py-2.5 border-2 border-gray-300 text-gray-400 font-bold rounded-xl text-sm hover:bg-gray-50 transition-all"
                    data-hs-overlay="#status-modal">
              Cancel
            </button>
            <button type="button" @onclick="UpdateStatus"
                    class="px-6 py-2.5 bg-[#f1a68e] text-white font-bold rounded-xl text-sm shadow-sm hover:bg-[#e0957d] transition-all">
              Update Order Status
            </button>
          </div>
        </div>
      </div>
    </div>
    @* End Status Modal *@
  }
</div>


<FilePreviewModal PreviewUrl="@_resultFile?.ResultFileUrl" FileName="@_resultFile?.ResultFileName"
                  ContentType="@ContentType"/>


@code {
  [Parameter] public string Id { get; set; } = string.Empty;
  private Order? _orderDetails;
  private ResultFileResponse? _resultFile;
  private string? ContentType { get; set; }
  private string _selectedStatus = string.Empty;
  private string _baseUrl = "https://api-staging.softetouch.com";

  private DiagnosticTestStatus CurrentStatus =>
    _orderDetails != null && Enum.TryParse<DiagnosticTestStatus>(_orderDetails.Status, out var status)
      ? status
      : DiagnosticTestStatus.Requested;

  private bool _isUploading;

  private string CurrentServiceType =>
    _orderDetails != null && Enum.IsDefined(typeof(LabServiceType), _orderDetails.ServiceType)
      ? SplitCamelCase(_orderDetails.ServiceType.ToString())
      : "Unknown Service";


  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await LoadOrderDetails();
      StateHasChanged();
    }
  }

  private async Task LoadOrderDetails()
  {
    try
    {
      var response = await OrderService.GetOrderDetailsAsync(Id);
      if (response is not null)
      {
        response.PatientImage = $"{_baseUrl}{response.PatientImage}";
        _orderDetails = response;
        if (Enum.TryParse<DiagnosticTestStatus>(_orderDetails?.Status, out var status))
        {
          _selectedStatus = status.ToString();
        }
      }
      else
      {
        await Notification.ShowError($"Failed to load order");
      }
    }
    catch (InvalidOperationException)
    {
    }
  }

  private async Task UpdateStatus()
  {
    try
    {
      var result = await OrderService.UpdateOrderStatusAsync(Id, _selectedStatus);
      if (result)
      {
        if (_orderDetails is not null)
        {
          _orderDetails.Status = _selectedStatus;
          await JsRuntime.InvokeVoidAsync("HSOverlay.close", "#status-modal");
          StateHasChanged();
          await Notification.ShowToast("Order status updated successfully!", 2000);
        }
      }
    }
    catch (Exception ex)
    {
      await Notification.ShowError($"Failed to update status: {ex.Message}");
    }
  }

  private async Task HandleFileSelected(InputFileChangeEventArgs e)
  {
    const long maxFileSize = 1024 * 1024 * 5; // 5MB limit
    string[] allowedDocs = [".pdf"];
    _isUploading = true;

    try
    {
      var file = e.File;

      if (file.Size > 0)
      {
        var extension = Path.GetExtension(file.Name).ToLower();
        var contentType = file.ContentType.ToLower();

        var isAllowedImage = contentType.StartsWith("image/");
        var isAllowedDoc = allowedDocs.Contains(extension);

        if (!isAllowedImage && !isAllowedDoc)
        {
          await Notification.ShowError("Invalid file! Please upload an Image, or PDF.");
          return;
        }

        if (file.Size > maxFileSize)
        {
          await Notification.ShowError("File is too large. Max 5MB allowed.");
          return;
        }

        var resultFileResponse = await OrderService.UploadOrderResultAsync(Id, file);

        if (resultFileResponse is not null)
        {
          ContentType = contentType;
          _resultFile = new()
          {
            ResultFileUrl = $"https://api-staging.softetouch.com/{resultFileResponse.ResultFileUrl}",
            ResultFileName = resultFileResponse.ResultFileName
          };
          _isUploading = false;
          await LoadOrderDetails();
          StateHasChanged();
          await Notification.ShowToast("File uploaded successfully", 2000);
        }
        else
        {
          await Notification.ShowError($"Upload failed");
        }
      }
    }
    catch (InvalidOperationException)
    {
    }
  }

  private int CalculateAge(string dateOfBirth)
  {
    var birthDate = DateTime.Parse(dateOfBirth);
    var age = new Age(birthDate, DateTime.Today).Years;

    return age;
  }

  private string SplitCamelCase(string input)
  {
    return System.Text.RegularExpressions.Regex.Replace(input, "([A-Z])", " $1").Trim();
  }

}
