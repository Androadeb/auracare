<div class="relative">
  <div
    class="absolute -left-[29px] top-1 w-5 h-5 rounded-full border-2 bg-white @(IsActive ? "border-teal-500" : "border-gray-200") flex items-center justify-center z-10">
    @if (IsActive)
    {
      <div class="w-2 h-2 rounded-full bg-teal-500"></div>
    }
  </div>
  <p class="text-xs font-bold text-[#002B49]">@Label</p>
  @if (!string.IsNullOrEmpty(Time))
  {
    <p class="text-xs text-gray-500">@Time</p>
  }
</div>

@code {
  [Parameter] public string Label { get; set; } = string.Empty;
  [Parameter] public string Time { get; set; } = string.Empty;
  [Parameter] public bool IsActive { get; set; }
}
