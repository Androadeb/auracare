@page "/about"

<div class="container-fluid py-10 px-6 sm:px-12  bg-white min-h-screen">
    <div class="mx-auto">

        <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-6 mb-8">

            <div class="relative w-full h-auto">
                <img src="assets/images/about/about-img.png" class="w-full max-w-lg h-auto object-cover bg-transparent" alt="Hero Image"/>
            </div>

            <div class="space-y-6 text-[#002B49]">
                <p class="text-base leading-relaxed">
                    We are a specialized digital dermatology platform offering free consultations with internationally accredited dermatologists.
                </p>
                <p class="text-base leading-relaxed">
                    Our goal is to provide a comprehensive treatment experience, from initial diagnosis and testing to medication delivery right to your door — all through a single, easy, and secure app.
                </p>
                <p class="text-base leading-relaxed font-medium">
                    We cater to all skincare needs for both men and women in the UAE, guaranteeing your privacy, medical quality, and a seamless experience from initial consultation to treatment delivery.
                </p>
            </div>
        </div>

        <div class="mb-16 ">
            <h2 class="text-3xl font-bold text-[#002B49] mb-10">How it Works</h2>

            <div class="space-y-6">
                @foreach (var step in _workflowSteps)
                {
                    <div class="bg-white rounded-full p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                        <div class="flex items-center gap-6 px-4">
                            <div class="w-3 h-3 rounded-full bg-[#f1a68e]"></div>

                            <div>
                                <h3 class="text-lg font-bold text-[#002B49]">@step.Title</h3>
                                <p class="text-sm text-gray-500 mt-1">@step.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex justify-end">
            <a href="https://staging.softetouch.com/ar/" target="_blank" rel="noopener noreferrer" class="bg-[#f1a68e] text-white px-8 py-3 rounded-2xl font-bold shadow-lg flex items-center gap-3 hover:bg-[#e0957d]">
                <img src="assets/images/icons/streamline-plump_browser-website-1-solid.svg" alt="Visit Landing Page">
                Visit Landing Page
            </a>
        </div>

    </div>
</div>

@code {

    private class WorkflowStep
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private readonly List<WorkflowStep> _workflowSteps = new()
    {
        new() { Title = "Authentication & Access", Description = "Labs securely access the dashboard through a login system. Different roles and permissions ensure that." },
        new() { Title = "User & Doctor Management", Description = "The lab can manage users and doctors efficiently by adding, editing, or updating profiles. Doctor information." },
        new() { Title = "Appointment Availability Management", Description = "The lab defines available appointment slots by selecting dates, time ranges, services, locations." },
        new() { Title = "Appointment & Order Processing", Description = "Once a patient books an appointment, it is automatically converted into an order. The lab can track each order." },
        new() { Title = "Medical Test Management", Description = "Labs can create, update, and manage available medical tests, including test details, preparation instructions, price." },
        new() { Title = "Financial Management", Description = "All financial activities are tracked in one place, including orders, balances and revenue This gives labs a clear view." },
        new() { Title = "Insights & Overview", Description = "The overview section provides key metrics and reports, such as daily cases, completed tests, and working hours." }
    };

}