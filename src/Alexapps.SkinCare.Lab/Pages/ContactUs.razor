@page "/contact-us"

<div class="container-fluid py-8 px-4 sm:px-10 bg-gray-50 min-h-screen">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-[#002B49] mb-8">Contact US</h1>

        <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-gray-100">
            <h2 class="text-lg font-bold text-[#002B49] mb-8">social media</h2>

            <div class="space-y-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-[#1e2d3b] text-white text-xl shadow-sm">
                        <img src="assets/images/icons/telephone-fill.svg" alt="telephone" class="w-6 h-6 white-filter"/>
                    </div>
                    <div class="flex-grow">
                        <input type="text" readonly value="+966 22 333 4444"
                               class="w-full bg-[#e9ecef] border-none rounded-2xl py-3 px-6 text-[#495057] focus:ring-0 cursor-default"/>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-[#25D366] text-white text-2xl shadow-sm">
                        <img src="assets/images/icons/whatsapp.svg" alt="whatsapp" class="w-6 h-6 white-filter"/>
                    </div>
                    <div class="flex-grow">
                        <input type="text" readonly value="+966 22 333 4444"
                               class="w-full bg-[#e9ecef] border-none rounded-2xl py-3 px-6 text-[#495057] focus:ring-0 cursor-default"/>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-[#d44638] text-white text-xl shadow-sm">
                        <img src="assets/images/icons/envelope-fill.svg" alt="envelope" class="w-6 h-6 white-filter"/>
                    </div>
                    <div class="flex-grow">
                        <input type="text" readonly value="example@gmail.com"
                               class="w-full bg-[#e9ecef] border-none rounded-2xl py-3 px-6 text-[#495057] focus:ring-0 cursor-default"/>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-[#1877F2] text-white text-2xl shadow-sm">
                        <img src="assets/images/icons/meta.svg" alt="meta" class="w-6 h-6 white-filter"/>
                    </div>
                    <div class="flex-grow">
                        <input type="text" readonly value="example@gmail.com"
                               class="w-full bg-[#e9ecef] border-none rounded-2xl py-3 px-6 text-[#495057] focus:ring-0 cursor-default"/>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-gradient-to-tr from-[#f9ce34] via-[#ee2a7b] to-[#6228d7] text-white text-2xl shadow-sm">
                        <img src="assets/images/icons/instagram.svg" alt="instagram" class="w-6 h-6 white-filter"/>
                    </div>
                    <div class="flex-grow">
                        <input type="text" readonly value="example@gmail.com"
                               class="w-full bg-[#e9ecef] border-none rounded-2xl py-3 px-6 text-[#495057] focus:ring-0 cursor-default"/>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-[#0088cc] text-white text-xl shadow-sm">
                        <img src="assets/images/icons/telegram.svg" alt="telegram" class="w-6 h-6 white-filter"/>
                    </div>
                    <div class="flex-grow">
                        <input type="text" readonly value="example@gmail.com"
                               class="w-full bg-[#e9ecef] border-none rounded-2xl py-3 px-6 text-[#495057] focus:ring-0 cursor-default"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>