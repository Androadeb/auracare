@page "/medical-tests"
@layout MainLayout

@attribute [Authorize(Roles = "LAB")]

<div class="md:flex block items-center justify-between">

    <div>
        <p class="font-semibold text-2xl text-defaulttextcolor dark:text-defaulttextcolor/70 !mb-1 ">
            Medical Tests
            Management
        </p>
        <span class="text-[#8c9097] text-[12px] dark:text-white/50">Manage your medical test catalog.</span>
    </div>

    <button type="button" @onclick="PrepareAdd" aria-label="button" data-hs-overlay="#add-test-modal"
            class="flex items-center !bg-lab-peach text-white !font-medium !me-[0.375rem] !ms-0 !text-[0.85rem] !rounded-[0.35rem] !py-[0.51rem] !px-[0.86rem] shadow-none dark:!bg-black">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="icon icon-tabler icons-tabler-outline icon-tabler-plus inline-block mr-1">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M12 5l0 14"/>
            <path d="M5 12l14 0"/>
        </svg>
        Add New Test
    </button>

</div>

<div class="bg-white mt-2 p-4 rounded-xl  dark:bg-black">

    <div class=" flex items-center gap-8 border-b border-gray-100 mb-6">
        <button @onclick="() => FilterByStatus(null)"
                class="pb-4 text-sm font-medium relative @(SelectedStatus == null ? "text-slate-800" : "text-gray-400")">
            All <span class="px-2 py-0.5 bg-slate-800 text-white text-[11px] rounded-md">@TotalCount</span>
            @if (SelectedStatus == null)
            {
                <div class="absolute bottom-0 start-0 w-full h-0.5 bg-slate-800"></div>
            }
        </button>

        <button @onclick="() => FilterByStatus(true)"
                class="pb-4 text-sm font-medium relative @(SelectedStatus == true ? "text-slate-800" : "text-gray-400")">
            Enabled <span class=" px-2 py-0.5 bg-green-100 text-green-600 text-[11px] rounded-md">@EnabledCount</span>
            @if (SelectedStatus == true)
            {
                <div class="absolute bottom-0 start-0 w-full h-0.5 bg-slate-800"></div>
            }
        </button>

        <button @onclick="() => FilterByStatus(false)"
                class="pb-4 text-sm font-medium relative @(SelectedStatus == false ? "text-slate-800" : "text-gray-400")">
            Disabled <span class=" px-2 py-0.5 bg-gray-100 text-gray-500 text-[11px] rounded-md">@DisabledCount</span>
            @if (SelectedStatus == false)
            {
                <div class="absolute bottom-0 start-0 w-full h-0.5 bg-slate-800"></div>
            }
        </button>
    </div>
    <div class="w-full mb-4 relative dark:bg-black">
        <input type="text"
               class="p-3 ps-10 mb-2 block w-full border-gray-100 rounded-xl text-sm focus:border-lab-peach focus:ring-lab-peach bg-white shadow-sm"
               placeholder="Search for tests by name (e.g. CBC)..." @oninput="OnSearchInput">
        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
            <svg class="w-4 h-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>
    </div>

    <div
        class="table-responsive bg-white rounded-xl shadow-sm border border-gray-100 p-4 dark:rgba(0,0,0,0.7) dark:bg-black">

        <table class="table whitespace-nowrap w-full min-w-full rounded-xl dark:bg-black">
            <thead>
            <tr class="bg-gray-300 border-b border-gray-100">
                <th class="text-start text-xs font-bold text-gray-400 uppercase p-4">
                    <input type="checkbox" class="form-check-input rounded-md"/>
                </th>
                <th class="text-start text-xs font-bold text-[#002B49] uppercase p-4">Test ID</th>
                <th class="text-start text-xs font-bold text-[#002B49] uppercase p-4">Test Name</th>
                <th class="text-start text-xs font-bold text-[#002B49] uppercase p-4">Category</th>
                <th class="text-start text-xs font-bold text-[#002B49] uppercase p-4">Price</th>
                <th class="text-start text-xs font-bold text-[#002B49] uppercase p-4">Duration</th>
                <th class="text-start text-xs font-bold text-[#002B49] uppercase p-4">Status</th>
                <th class="text-start text-xs font-bold text-[#002B49] uppercase p-4">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:bg-black">
            @foreach (var test in _tests)
            {
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="p-4">
                        <input type="checkbox" class="form-check-input rounded-md"/>
                    </td>
                    <td class="p-4 text-sm text-gray-600">@test.Id</td>
                    <td class="p-4 text-sm font-bold text-[#002B49]">@test.TestName</td>
                    <td class="p-4 text-sm text-gray-600">@test.CategoryName</td>
                    <td class="p-4 text-sm text-gray-600">@test.LabPrice.ToString("0.00 'D'")</td>
                    <td class="p-4 text-sm text-gray-600">@test.Duration</td>
                    <td class="p-4">
                        @if (test.IsEnabled)
                        {
                            <span class="px-3 py-1 text-xs font-bold text-green-600 bg-green-50 rounded-lg">Enabled</span>
                        }
                        else
                        {
                            <span class="px-3 py-1 text-xs font-bold text-red-600 bg-red-50 rounded-lg">Disabled</span>
                        }
                    </td>
                    <td class="p-4">
                        <div class="hs-dropdown ti-dropdown relative inline-flex [--placement:bottom-right]">
                            <button id="dropdown-@test.Id" type="button"
                                    class="hs-dropdown-toggle ti-dropdown-toggle p-2 text-gray-400 hover:text-gray-600">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="currentColor"
                                     class="icon icon-tabler icons-tabler-filled icon-tabler-dots-vertical text-lg">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path
                                        d="M14 12a2 2 0 1 1 -4 0q 0 -.053 .005 -.102a1.996 1.996 0 0 1 1.995 -1.898a2 2 0 0 1 2 2"/>
                                    <path
                                        d="M14 19a2 2 0 1 1 -4 0q 0 -.052 .005 -.102a1.996 1.996 0 0 1 1.995 -1.898a2 2 0 0 1 2 2"/>
                                    <path
                                        d="M14 5a2 2 0 1 1 -4 0q 0 -.053 .005 -.102a1.996 1.996 0 0 1 1.995 -1.898a2 2 0 0 1 2 2"/>
                                </svg>
                            </button>

                            <div class="hs-dropdown-menu ti-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-[10rem] bg-white shadow-md rounded-lg p-2 mt-2 z-10 border border-gray-100"
                                 aria-labelledby="dropdown-@test.Id">

                                <button @onclick="() => EditTest(test)"
                                        class="flex items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-gray-800 hover:bg-gray-100 w-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round"
                                         class="icon icon-tabler icons-tabler-outline icon-tabler-edit mr-1">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"/>
                                        <path
                                            d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415"/>
                                        <path d="M16 5l3 3"/>
                                    </svg> Edit
                                </button>

                                <hr class="my-1 border-gray-100"/>

                                <button @onclick="() => DeleteTest(test)"
                                        class="flex items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-red-600 hover:bg-red-50 w-full">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round"
                                         class="icon icon-tabler icons-tabler-outline icon-tabler-trash mr-1">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M4 7l16 0"/>
                                        <path d="M10 11l0 6"/>
                                        <path d="M14 11l0 6"/>
                                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/>
                                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/>
                                    </svg> Delete
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>

        </table>
        <div class="flex items-center justify-between p-4 bg-white border-t border-gray-50 w-full dark:bg-black">
            <div class="flex items-center gap-2">
                <button @onclick="PrevPage" disabled="@(CurrentPage == 1)"
                        class="p-2 border rounded-lg text-gray-400 hover:bg-gray-50 disabled:opacity-30">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M15 6l-6 6l6 6"/>
                    </svg>
                </button>

                <span class="text-sm text-gray-500">
                    @((CurrentPage - 1) * PageSize + 1) - @Math.Min(CurrentPage * PageSize, TotalCount) of @TotalCount
                </span>

                <button @onclick="NextPage" disabled="@(CurrentPage == TotalPages)"
                        class="p-2 border rounded-lg text-gray-400 hover:bg-gray-50 disabled:opacity-30">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M9 6l6 6l-6 6"/>
                    </svg>
                </button>
            </div>
            <div class="flex items-center gap-2 text-sm text-gray-500">
                Rows per page:
                <select @onchange="ChangePageSize"
                        class="border-none bg-transparent font-bold text-[#002B49] focus:ring-0 cursor-pointer">
                    <option value="6">6</option>
                    <option value="12">12</option>
                    <option value="20">20</option>
                </select>
            </div>
        </div>
    </div>

</div>

<!-- Medical Test Modal-->

<div id="add-test-modal"
     class="hs-overlay w-full h-full hidden fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto ">
    <div
        class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto">
        <div class="flex flex-col bg-white border-0 shadow-lg rounded-md dark:bg-black p-4">

            <div class="flex justify-between items-start pt-6 px-6 pb-2">
                <div>
                    <h3 class="text-xl font-semibold text-[#002B49] dark:text-white">
                        @(IsEditing ? "Edit Medical Test" : "Add New Medical Test")
                    </h3>
                    <p class="text-sm text-gray-400 mt-1">
                        @(IsEditing ? "Edit the details of the new medical test" : "Enter the details of the new medical test")
                    </p>
                </div>
                <button type="button" class="text-gray-400 hover:text-gray-600" data-hs-overlay="#add-test-modal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-x text-xl">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path
                            d="M6.707 5.293l5.293 5.292l5.293 -5.292a1 1 0 0 1 1.414 1.414l-5.292 5.293l5.292 5.293a1 1 0 0 1 -1.414 1.414l-5.293 -5.292l-5.293 5.292a1 1 0 1 1 -1.414 -1.414l5.292 -5.293l-5.292 -5.293a1 1 0 0 1 1.414 -1.414"/>
                    </svg>
                </button>
            </div>

            <EditForm Model="@_newTest" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator/>

                <div class="px-6 py-4">
                    <div class="flex flex-col gap-4">

                        <div>
                            <label class="text-[#002B49] font-bold mb-2 block dark:text-white">Category</label>
                            <InputSelect @bind-Value="_newTest.TestCategoryId"
                                         @bind-Value:after="OnCategorySelectionChanged"
                                         class="form-control w-full border-gray-200 rounded-xl p-3 bg-white appearance-none">

                                <option value="">-- Select Category --</option>

                                @if (_medicalTestCategories != null)
                                {
                                    @foreach (var category in _medicalTestCategories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => _newTest.TestCategoryId)" class="text-danger text-xs mt-1"/>
                        </div>

                        <div>
                            <label class="text-[#002B49] font-bold mb-2 block dark:text-white">Test Name</label>
                            <InputSelect @bind-Value="_newTest.MedicalTestId"
                                         disabled="@(!_availableTestsForCategory.Any())"
                                         class="form-control w-full border-gray-200 rounded-xl p-3 bg-white">
                                <option value="">-- Select Test --</option>
                                @foreach (var test in _availableTestsForCategory)
                                {
                                    <option value="@test.Id">@test.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _newTest.MedicalTestId)" class="text-danger text-xs mt-1"/>
                        </div>

                        <div>
                            <label
                                class="text-[#002B49] font-bold mb-2 block text-capitalize dark:text-white">
                                price
                            </label>
                            <InputNumber @bind-Value="_newTest.LabPrice"
                                         class="form-control w-full border-gray-200 rounded-xl p-3 bg-white"
                                         placeholder="45 D"/>
                            <ValidationMessage For="@(() => _newTest.LabPrice)" class="text-danger text-xs mt-1"/>
                        </div>

                        <div>
                            <label class="text-[#002B49] font-bold mb-2 block dark:text-white">Duration</label>
                            <InputText @bind-Value="_newTest.Duration"
                                       class="form-control w-full border-gray-200 rounded-xl p-3 bg-white"
                                       placeholder="2-4 Hours"/>
                            <ValidationMessage For="@(() => _newTest.Duration)" class="text-danger text-xs mt-1"/>
                        </div>

                        <div>
                            <label class="text-[#002B49] font-bold mb-2 block dark:text-white">Service Location</label>
                            <InputSelect @bind-Value="_newTest.ServiceScope"
                                         class="form-control w-full border-gray-200 rounded-xl p-3 bg-white">
                                <option value="">-- Select Location --</option>
                                <option value="LabVisitOnly">Lab Visit Only</option>
                                <option value="Both">Both</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _newTest.ServiceScope)" class="text-danger text-xs mt-1"/>
                        </div>

                        <div class="flex justify-between items-center mt-2">
                            <label class="text-[#002B49] font-bold dark:text-white">Status</label>
                            <div class="flex items-center gap-2">
                                <div class="flex items-center form-check form-switch">
                                    <InputCheckbox @bind-Value="_newTest.IsEnabled" class="form-check-input"
                                                   id="statusToggle"/>
                                </div>
                                <span class="text-gray-600">Enabled</span>
                            </div>
                            <ValidationMessage For="@(() => _newTest.IsEnabled)" class="text-danger text-xs mt-1"/>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end items-center gap-4 p-6 mt-2">
                    <button type="button"
                            class="w-32 py-3 rounded-xl font-bold !border-2 !border-[#F87171] !text-[#F87171] bg-white hover:bg-red-50 transition-colors hover-effect dark:bg-black"
                            data-hs-overlay="#add-test-modal" style="border:2px solid #F87171; width:128px; color:#F87171;">
                        Cancel
                    </button>
                    <button type="submit"
                            class="w-40 py-3 rounded-xl font-bold text-white shadow-sm active:scale-95 transition-all dark:!bg-black border-2 border-white"
                            style="background-color: #f1a68e; width: 160px;">
                        @if (IsEditing)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="icon icon-tabler icons-tabler-outline icon-tabler-edit inline-block mr-1">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"/>
                                <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415"/>
                                <path d="M16 5l3 3"/>
                            </svg>

                            @("Edit Test")
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="currentColor"
                                 class="icon icon-tabler icons-tabler-filled icon-tabler-plus inline-block mr-1">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path
                                    d="M12 4a1 1 0 0 1 1 1v6h6a1 1 0 0 1 0 2h-6v6a1 1 0 0 1 -2 0v-6h-6a1 1 0 0 1 0 -2h6v-6a1 1 0 0 1 1 -1"/>
                            </svg>
                            @("Add Test")
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>
