@page "/admin/medical-tests"
@using Microsoft.Extensions.Localization
@inject AlexApps.Classat.Blazor.Superadmin.Services.JsonLocalizationService L
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "DOCTOR")]

<div class="p-6">
    @* --- Header --- *@
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h3 class="text-defaulttextcolor dark:text-white text-[1.5rem] font-bold">@L["MedicalTestsTitle"]</h3>
            <p class="text-[#8c9097] dark:text-white/50 text-[0.75rem]">@L["MedicalTestsSubTitle"]</p>
        </div>
    </div>

    @* --- Tabs --- *@
    <div class="flex items-center gap-8 mb-6 border-b border-gray-100 dark:border-white/10 overflow-x-auto">
        @* All *@
        <button @onclick='() => activeTab = "All"' class='pb-3 px-1 transition-all relative flex items-center gap-2 @(activeTab == "All" ? "font-bold" : "")' style="color: @(activeTab == "All" ? "#0f172a" : "#94a3b8"); border: none; background: none;">
            <span class="text-[0.95rem]">@L["All"]</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background-color: #1e293b !important; color: white !important;">@CountAll</span>
            @if (activeTab == "All")
            {
                <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-[#0f172a] dark:bg-white rounded-t-full"></div>
            }
        </button>

        @* Requested *@
        <button @onclick='() => activeTab = "Requested"' class='pb-3 px-1 transition-all relative flex items-center gap-2 @(activeTab == "Requested" ? "font-bold" : "")' style="color: @(activeTab == "Requested" ? "#0f172a" : "#94a3b8"); border: none; background: none;">
            <span class="text-[0.95rem]">@L["Requested"]</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background-color: #e0faff !important; color: #0ea5e9 !important;">@CountRequested</span>
            @if (activeTab == "Requested")
            {
                <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-[#0f172a] dark:bg-white rounded-t-full"></div>
            }
        </button>

        @* Sample Collected *@
        <button @onclick='() => activeTab = "SampleCollected"' class='pb-3 px-1 transition-all relative flex items-center gap-2 @(activeTab == "SampleCollected" ? "font-bold" : "")' style="color: @(activeTab == "SampleCollected" ? "#0f172a" : "#94a3b8"); border: none; background: none;">
            <span class="text-[0.95rem]">@L["SampleCollected"]</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background-color: #ede9fe !important; color: #8b5cf6 !important;">@CountSampleCollected</span>
            @if (activeTab == "SampleCollected")
            {
                <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-[#0f172a] dark:bg-white rounded-t-full"></div>
            }
        </button>

        @* In Progress *@
        <button @onclick='() => activeTab = "InProgress"' class='pb-3 px-1 transition-all relative flex items-center gap-2 @(activeTab == "InProgress" ? "font-bold" : "")' style="color: @(activeTab == "InProgress" ? "#0f172a" : "#94a3b8"); border: none; background: none;">
            <span class="text-[0.95rem]">@L["InProgressTab"]</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background-color: #fef3c7 !important; color: #d97706 !important;">@CountInProgress</span>
            @if (activeTab == "InProgress")
            {
                <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-[#0f172a] dark:bg-white rounded-t-full"></div>
            }
        </button>

        @* Result Ready *@
        <button @onclick='() => activeTab = "ResultReady"' class='pb-3 px-1 transition-all relative flex items-center gap-2 @(activeTab == "ResultReady" ? "font-bold" : "")' style="color: @(activeTab == "ResultReady" ? "#0f172a" : "#94a3b8"); border: none; background: none;">
            <span class="text-[0.95rem]">@L["ResultReady"]</span>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold" style="background-color: #dcfce7 !important; color: #15803d !important;">@CountResultReady</span>
            @if (activeTab == "ResultReady")
            {
                <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-[#0f172a] dark:bg-white rounded-t-full"></div>
            }
        </button>
    </div>

    @* --- Filters & Search --- *@
    <div class="flex items-center gap-4 mb-4 overflow-x-auto">
        <div class="relative w-full max-w-md">
            <input type="text" @bind-value="searchTerm" @bind-value:event="oninput" placeholder='@L["SearchPlaceholder"]' class="form-control w-full !rounded-xl border-gray-200 dark:border-white/10 bg-white dark:bg-[#1f2937] text-defaulttextcolor dark:text-white focus:ring-primary/20 pl-10" />
            <i class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>
    </div>

    @* --- Data Table & Pagination Container --- *@
    <div class="box custom-box border border-gray-100 dark:border-gray-700 rounded-xl bg-white dark:bg-[#1f2937] overflow-hidden">
        <div class="box-body !p-0">
            <div class="table-responsive">
                <table class="table whitespace-nowrap min-w-full">
                    <thead>
                        <tr class="border-b border-gray-100 dark:border-gray-700 text-start">
                            <th class="p-4 w-10 text-center"><input type="checkbox" class="form-check-input" /></th>
                            <th class="p-4 text-[0.75rem] font-bold text-[#8c9097] uppercase">@L["PatientName"]</th>
                            <th class="p-4 text-[0.75rem] font-bold text-[#8c9097] uppercase">@L["TestType"]</th>
                            <th class="p-4 text-[0.75rem] font-bold text-[#8c9097] uppercase">@L["RequestedDate"]</th>
                            <th class="p-4 text-[0.75rem] font-bold text-[#8c9097] uppercase">@L["Status"]</th>
                            <th class="p-4 w-10"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var test in FilteredTests)
                        {
                            <tr class="hover:bg-gray-50/50 dark:hover:bg-white/5 transition-colors cursor-pointer"
                                @onclick='() => NavigationManager.NavigateTo($"/admin/medical-tests-details/{test.id}")'>
                                <td class="p-4 text-center" @onclick:stopPropagation="true"><input type="checkbox" class="form-check-input" /></td>
                                <td class="p-4">
                                    <div class="flex items-center gap-3">
                                        @{
                                            var baseUrl = "https://auraskin.runasp.net";
                                            var fullImageUrl = !string.IsNullOrEmpty(test.patientImage)
                                            ? $"{baseUrl.TrimEnd('/')}/{test.patientImage.TrimStart('/')}"
                                            : null;
                                        }

                                        @if (!string.IsNullOrEmpty(fullImageUrl))
                                        {
                                            <img src="@fullImageUrl" class="w-10 h-10 rounded-full object-cover border border-slate-200 shadow-sm" alt="@test.patientName" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600 border border-slate-300">
                                                @(string.IsNullOrEmpty(test.patientName) ? "?" : test.patientName[0].ToString().ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <div class="text-[0.85rem] font-bold text-defaulttextcolor dark:text-white">@test.patientName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4 text-[0.8rem]">@test.testType</td>
                                <td class="p-4 text-[0.8rem]">
                                    @test.requestedDate.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)
                                </td>
                                <td class="p-4">
                                    <span class="px-3 py-1.5 rounded-lg text-[11px] font-bold uppercase inline-block" style="@GetStatusStyle(test.status)">
                                        @L[MapStatus(test.status)]
                                    </span>
                                </td>
                                <td class="p-4"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* --- Pagination Section --- *@
            <div class="flex items-center justify-between p-4 border-t border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-white/5">
                <div class="text-[0.75rem] text-[#8c9097] dark:text-white/50">
                    @L["ShowingPage"] <span class="font-bold text-defaulttextcolor dark:text-white">@currentPage</span> @L["Of"] <span class="font-bold text-defaulttextcolor dark:text-white">@totalPages</span>
                </div>
                <div class="flex items-center gap-2">
                    <button @onclick="() => ChangePage(currentPage - 1)"
                            disabled="@(!hasPreviousPage)"
                            class="p-2 rounded-lg border border-gray-200 dark:border-white/10 hover:bg-white dark:hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        <i class="ri-arrow-left-s-line"></i>
                    </button>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNumber = i;
                        if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                        {
                            <button @onclick="() => ChangePage(pageNumber)"
                                    class="w-8 h-8 rounded-lg text-[0.75rem] font-bold transition-colors @(currentPage == pageNumber ? "bg-[#0f172a] text-white dark:bg-white dark:text-[#0f172a]" : "text-[#8c9097] hover:bg-white dark:hover:bg-white/10 border border-transparent hover:border-gray-200 dark:hover:border-white/10")">
                                @pageNumber
                            </button>
                        }
                        else if (i == currentPage - 2 || i == currentPage + 2)
                        {
                            <span class="text-[#8c9097]">...</span>
                        }
                    }

                    <button @onclick="() => ChangePage(currentPage + 1)"
                            disabled="@(!hasNextPage)"
                            class="p-2 rounded-lg border border-gray-200 dark:border-white/10 hover:bg-white dark:hover:bg-white/10 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        <i class="ri-arrow-right-s-line"></i>
                    </button>
                </div>
            </div>
        </div> 
    </div> 
</div> 