@page "/admin/about"
@using Microsoft.Extensions.Localization
@inject AlexApps.Classat.Blazor.Superadmin.Services.JsonLocalizationService L

<div class="about-container p-4" style="background-color: #f9f9f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; min-height: 100vh;">

    <!-- Hero Section -->
    <div class="row mb-5 align-items-center" style="margin-top: 20px; display: flex; flex-wrap: wrap;">
        <div class="col-lg-6 position-relative" style="flex: 0 0 50%; max-width: 50%;">
            <!-- Visual Stack from image_aa0df6.png -->
            <div class="image-stack" style="position: relative; height: 400px; display: flex; align-items: center;">

                <!-- Peach Background Shape -->
                <div class="bg-shape" style="width: 280px; height: 280px; background: #ef9d87; opacity: 0.3; border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; position: absolute; top: -10px; left: 40px; z-index: 0;"></div>

                <!-- Male Doctor Image (Left) -->
                <img src="assets/images/apps/doctor-male.jpg"
                     style="width: 200px; height: 280px; object-fit: cover; border-radius: 20px; border: 5px solid #fff; position: absolute; left: 0; bottom: 40px; z-index: 2; box-shadow: 0 10px 20px rgba(0,0,0,0.1);"
                     alt="Doctor Specialist" />

                <!-- Female Doctor & Patient Image (Right) -->
                <img src="assets/images/apps/doctor-female.jpg"
                     style="width: 300px; height: 320px; object-fit: cover; border-radius: 25px; border: 5px solid #fff; position: absolute; left: 130px; top: 10px; z-index: 1; box-shadow: 0 10px 20px rgba(0,0,0,0.1);"
                     alt="Consultation Session" />
            </div>
        </div>

        <div class="col-lg-6" style="flex: 0 0 50%; max-width: 50%; padding-left: 30px;">
            <p style="color: #333; line-height: 1.6; font-size: 1.15rem; margin-bottom: 25px; font-weight: 500;">
                We are a specialized digital dermatology platform offering free consultations with internationally accredited dermatologists.
            </p>
            <p style="color: #333; line-height: 1.6; font-size: 1.15rem; margin-bottom: 25px; font-weight: 500;">
                Our goal is to provide a comprehensive treatment experience, from initial diagnosis and testing to medication delivery right to your door — all through a single, easy, and secure app.
            </p>
            <p style="color: #333; line-height: 1.6; font-size: 1.15rem; font-weight: 500;">
                We cater to all skincare needs for both men and women in the UAE, guaranteeing your privacy, medical quality, and a seamless experience from initial consultation to treatment delivery.
            </p>
        </div>
    </div>

    <!-- How it Works Section -->
    <div class="steps-section" style="margin-top: 60px;">
        <h2 style="font-weight: 700; color: #222; margin-bottom: 30px; font-size: 2rem;">@L["How It Works"]</h2>

        <div style="display: flex; flex-direction: column; gap: 15px;">
            @foreach (var step in WorkflowSteps)
            {
                <div class="step-card"
                     style="display: flex; flex-direction: column; padding: 18px 45px; background-color: #fff; border-radius: 50px; border: 1px solid #eee; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                    <span style="font-weight: 700; color: #333; font-size: 1.1rem;">@L[step.Title]</span>
                    <small style="color: #666; font-size: 0.95rem; margin-top: 4px;">@L[step.Description]</small>
                </div>
            }
        </div>
    </div>

    <!-- Footer Action -->
    <div style="display: flex; justify-content: flex-end; margin-top: 40px; padding-bottom: 30px;">
        <button style="background-color: #ef9d87; color: white; border: none; border-radius: 30px; padding: 12px 30px; font-weight: 600; font-size: 1rem; display: flex; align-items: center; cursor: pointer; box-shadow: 0 4px 12px rgba(239, 157, 135, 0.3);">
            <i class="ri-calendar-event-line" style="margin-right: 10px; font-size: 1.2rem;"></i> @L["Visit Landing Page"]
        </button>
    </div>
</div>