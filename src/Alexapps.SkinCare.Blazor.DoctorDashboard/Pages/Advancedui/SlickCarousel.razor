    <!-- Start:: row-2 -->
    <div class="grid grid-cols-12 gap-x-3">
        <div class="xl:col-span-12 sm:col-span-12 col-span-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-title">
                        Responsive Blazor Slick Carousel
                    </div>
                </div>
                <div class="box-body">
                    <BlazorSlickCarousel Configurations="ResponsiveConfigurations">
                        <BlazorSlickCarouselContent>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-40.jpg" alt=""></div>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-41.jpg" alt=""></div>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-42.jpg" alt=""></div>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-43.jpg" alt=""></div>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-44.jpg" alt=""></div>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-59.jpg" alt=""></div>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-46.jpg" alt=""></div>
                            <div class="Carousel-slide"><img src="../assets/images/media/media-61.jpg" alt=""></div>
                        </BlazorSlickCarouselContent>
                    </BlazorSlickCarousel>
                </div>
