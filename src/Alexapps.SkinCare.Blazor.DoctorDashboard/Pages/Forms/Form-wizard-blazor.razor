@page "/blazor_wizard"
@using VDT.Core.Blazor.Wizard
@using FlatpickrBlazor
@using FlatpickrBlazor.Components
@inject IJSRuntime JSRuntime
@using Soenneker.Blazor.TomSelect
@using Soenneker.Blazor.TomSelect.Base 
@using Soenneker.Blazor.TomSelect.Dtos
@using System.Collections.Generic
@inject SweetAlertService Swal
@using System.Text;
@inject NavigationManager NavigationManager
@using System.ComponentModel.DataAnnotations;

<!-- Flatpickr Css -->
<link href="_content/FlatpickrBlazor/flatpickr.min.css" rel="stylesheet" />

<!-- Tom Select CSS -->
<link rel="stylesheet" href="../assets/libs/tom-select/css/tom-select.bootstrap5.min.css">

    <!-- Page Header -->
    <div class="block justify-between page-header md:flex">
        <div>
            <h3 class="!text-defaulttextcolor dark:!text-defaulttextcolor/70 dark:text-white dark:hover:text-white text-[1.125rem] font-semibold"> Blazor form wizard</h3>
        </div>
        <ol class="flex items-center whitespace-nowrap min-w-0">
            <li class="text-[0.813rem] ps-[0.5rem]">
                <a class="flex items-center text-primary hover:text-primary dark:text-primary truncate" href="javascript:void(0);">
                Form Wizard
                <i class="ti ti-chevrons-right flex-shrink-0 text-[#8c9097] dark:text-white/50 px-[0.5rem] overflow-visible rtl:rotate-180"></i>
                </a>
            </li>
            <li class="text-[0.813rem] text-defaulttextcolor font-semibold hover:text-primary dark:text-[#8c9097] dark:text-white/50 " aria-current="page">
                Blazor form wizard
            </li>
        </ol>
    </div>
    <!-- Page Header Close -->

    
    <!-- Start::row-1 -->
    <div class="grid grid-cols-12 gap-x-6">
        <div class="xl:col-span-12 col-span-12">
            <div class="box overflow-hidden">
                <div class="box-header">
                    <div class="box-title">
                        FORM WIZARD
                    </div>
                </div>
                <div class="box-body p-0">
                    <Wizard @ref="Wizard2" 
                        ButtonClass="wizard-button" 
                        ButtonPreviousClass="ti-btn-primary ti-btn"
                        ButtonPreviousText="<< Prev" 
                        ButtonFinishClass="ti-btn-primary-full ti-btn"
                        ButtonFinishText="Complete" 
                        ButtonNextClass="ti-btn-primary-full ti-btn" 
                        ButtonNextText="Next >>" 
                        StepTitleClass="blazorwizard-step ti-btn-primary ti-btn w-full mb-2 lg:mb-0"
                        ActiveStepTitleClass="fw-bold active"
                        AllowCancel="true"
                        AllowPrevious="true" OnFinish="OnWizardFinish">
                        <Layout>
                            <div class="wizard ">
                                <div class="container-lg">
                                    <div class="box-body  md:flex justify-between gap-4">
                                        @context.StepTitles
                                    </div> 
                                    <div class="wizard-body box-body">
                                        @context.Content
                                    </div>
                                </div>
                                <div class="wizard-buttons box-footer flex justify-between">
                                    @context.ButtonPrevious
                                    <div class="text-end">
                                        @context.ButtonNext
                                        @context.ButtonFinish
                                    </div>
                                </div>
                            </div>
                        </Layout>
                        <Steps>
                            <WizardStep Title="Personal Information"  OnInitialize="args => InitializeStep(args, 1)" OnTryComplete="args => args.IsCancelled = !AccountContext?.Validate() ?? true">
                                <div class="grid justify-content-center">
                                    <EditForm EditContext="AccountContext">
                                        <DataAnnotationsValidator />
                                        <div class="xl:col-span-12 col-span-12">
                                            <div class="register-page">
                                                <h6 class="mb-3">Registration :</h6>
                                                <div class="grid grid-cols-12 sm:gap-x-6 gap-y-3">
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label for="Customer" class="form-label">First Name</label>
                                                        <InputText @bind-Value="Account.personName" id="personName" class="form-control" placeholder="Enter first name" />
                                                        <ValidationMessage For="() => Account.personName" class="text-danger fs-13" />
                                                    </div>
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label for="last-name" class="form-label">Last Name</label>
                                                        <InputText @bind-Value="Account.LastName" id="LastName" class="form-control" placeholder="Enter Last name" />
                                                        <ValidationMessage For="() => Account.LastName" class="text-danger fs-13" />
                                                    </div>
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label for="Email" class="form-label">Email Address</label>
                                                        <InputText @bind-Value="Account.EmailAddress" id="EmailAddress" class="form-control" placeholder="Enter Email Adress" />
                                                        <ValidationMessage For="() => Account.EmailAddress" class="text-danger fs-13" />
                                                    </div>
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label class="form-label">Phone Number</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text"
                                                                id="inputGroup-sizing-default">+99</span>
                                                            <InputText @bind-Value="Account.PhoneNumber" id="PhoneNumber" class="form-control" placeholder="Enter Phone number" />
                                                        </div>
                                                        <ValidationMessage For="() => Account.PhoneNumber" class="text-danger fs-13" />
                                                    </div>
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label class="form-label">Date of Birth</label>
                                                        <div class="input-group">
                                                            <div class="input-group-text text-muted">
                                                                <i class="ri-calendar-line"></i>
                                                            </div> 
                                                            <Flatpickr class="form-control" @ref="_flatpickr" placeholder="Choose date"/>
                                                        </div>
                                                    </div>
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label class="form-label">Select Gender :</label>
                                                        <TomSelect TItem="SelectItem" Items=_selectedItems  TType="string" Multiple="false" @bind-Value="_selectedValue" Data="_options" TextField="@(item => item.Name)" ValueField="@(item => item.Id)" Placeholder="Open this select menu" />
                                                    </div>
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label class="form-label">Country</label>
                                                        <TomSelect TItem="CountryItem" Items=_CountryItems  TType="string" Multiple="false" @bind-Value="_CountryValue" Data="_Countryoptions" TextField="@(item => item.CountryName)" ValueField="@(item => item.CountryId)" Placeholder="Open this select menu" />
                                                    </div>
                                                    <div class="md:col-span-6 col-span-12">
                                                        <label class="form-label">Select City:</label>
                                                        <TomSelect TItem="CityItem" Items=_CityItems  TType="string" Multiple="false" @bind-Value="_CityValue" Data="_Cityoptions" TextField="@(item => item.CityName)" ValueField="@(item => item.CityId)" Placeholder="Open this select menu" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </EditForm>
                                </div>
                            </WizardStep>
                            <WizardStep Title="Select Service" OnInitialize="args => InitializeStep(args, 2)">
                                <div class="grid grid-cols-12 sm:gap-x-6 gap-y-4">
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-primary/10 text-primary">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked">Cardio Check</label>
                                                    <span class="fs-12 text-muted">$249</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-primary rounded-full" type="checkbox" value="" id="flexCheckChecked" checked>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-secondary/10 text-secondary">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked1">Ortho Consult</label>
                                                    <span class="fs-12 text-muted">$120</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-secondary rounded-full" type="checkbox" value="" id="flexCheckChecked1">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-success/10 text-success">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked2">Gyn Exam</label>
                                                    <span class="fs-12 text-muted">$100</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-success rounded-full" type="checkbox" value="" id="flexCheckChecked2">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-orange/10 text-orange">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked3">Pediatric Vaccines</label>
                                                    <span class="fs-12 text-muted">$50</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-orange rounded-full" type="checkbox" value="" id="flexCheckChecked3">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-info/10 text-info">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked4">Dental Checkup</label>
                                                    <span class="fs-12 text-muted">$80</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-info rounded-full" type="checkbox" value="" id="flexCheckChecked4">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-warning/10 text-warning">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked5">X-ray Imaging</label>
                                                    <span class="fs-12 text-muted">$80</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-warning rounded-full" type="checkbox" value="" id="flexCheckChecked5">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-danger/10 text-danger">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked6">Blood Tests</label>
                                                    <span class="fs-12 text-muted">Varies</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-danger rounded-full" type="checkbox" value="" id="flexCheckChecked6">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="xl:col-span-3 lg:col-span-6 md:col-span-6 col-span-12">
                                        <div class="col">
                                            <div class="form-check flex items-center gap-3 p-2 border rounded-full dark:border-defaultborder/10">
                                                <div>
                                                    <span class="avatar avatar-lg avatar-rounded bg-dark/10 text-dark">
                                                        <i class="bi bi-hospital fs-5"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-auto">
                                                    <label class="form-check-label block fw-medium text-base !ps-0" for="flexCheckChecked7">Eye Exam</label>
                                                    <span class="fs-12 text-muted">$90</span>
                                                </div>
                                                <div>
                                                    <input class="form-check-input form-checked-dark rounded-full" type="checkbox" value="" id="flexCheckChecked7">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </WizardStep>
                            <WizardStep Title="Appointment Details" OnInitialize="args => InitializeStep(args, 3)">
                                <div class="grid grid-cols-12 sm:gap-x-6 justify-center summary-view">
                                    <div class="xl:col-span-3"></div>
                                    <div class="xl:col-span-6 col-span-12">
                                        <div class="border dark:border-defaultborder/10 border-bottom-0 rounded-1 mb-3 ">
                                            <div class="box-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table text-nowrap w-full">
                                                        <thead>
                                                            <tr class="bg-light">
                                                                <th scope="col">Personal Details</th>
                                                                <th scope="col"></th>
                                                                <th scope="col"></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span class="block fw-semibold">First
                                                                        Name</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start  text-muted">
                                                                    @Account.personName
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span class="block fw-semibold">Last Name
                                                                    </span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    @Account.LastName
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span class="block fw-semibold">EmailAddress</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    @Account.EmailAddress
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span class="block fw-semibold">Phone
                                                                        Number</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    @Account.PhoneNumber
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span class="block fw-semibold">Country
                                                                    </span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    India
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="border dark:border-defaultborder/10 border-bottom-0 rounded-1 mb-3 ">
                                            <div class="box-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table text-nowrap w-full">
                                                        <thead>
                                                            <tr class="bg-light">
                                                                <th scope="col">Appointment Details</th>
                                                                <th scope="col"></th>
                                                                <th scope="col"></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span
                                                                        class="block fw-semibold">Category</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start  text-muted">
                                                                    Neuro Clinic
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span
                                                                        class="block fw-semibold">Service</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    Heart Care
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span class="block fw-semibold">Service
                                                                        providers</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    Jiohn Alzian
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span
                                                                        class="block fw-semibold">Branch</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    India
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span
                                                                        class="block fw-semibold">Appointment
                                                                        Date</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    12-Sep-2024
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span
                                                                        class="block fw-semibold">Appointment
                                                                        Time</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start text-muted">
                                                                    10:00 AM
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="border dark:border-defaultborder/10 border-bottom-0 rounded-1 mb-3 ">
                                            <div class="box-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table text-nowrap w-full">
                                                        <thead>
                                                            <tr class="bg-light">
                                                                <th scope="col">Payment Details</th>
                                                                <th scope="col"></th>
                                                                <th scope="col"></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td class="w-25">
                                                                    <span class="block fw-semibold">Mode of
                                                                        Payment</span>
                                                                </td>
                                                                <td class="w-10">:</td>
                                                                <td class="text-start  text-muted">
                                                                    Paypal
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="p-3 rounded-2 bg-light">
                                            <label  class="mb-1 fw-semibold">Source Information:</label>
                                            <div class="flex items-center flex-wrap gap-2">
                                                <div class="form-check-sm">
                                                    <input class="form-check-input" type="radio" name="Radio"
                                                        id="Radio-sm">
                                                    <label class="form-check-label" for="Radio-sm"> Google
                                                    </label>
                                                </div>
                                                <div class="form-check-sm ">
                                                    <input class="form-check-input" type="radio" name="Radio"
                                                        id="Radio-md">
                                                    <label class="form-check-label" for="Radio-md">
                                                        Advertisement </label>
                                                </div>
