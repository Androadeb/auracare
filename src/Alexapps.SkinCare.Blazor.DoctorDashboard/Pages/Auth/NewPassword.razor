@page "/auth/NewPassword"
@using Microsoft.Extensions.Localization
@layout CustomLayout
@inject IStringLocalizer<VerifyOtp> L

<div class="min-h-screen flex items-center justify-center bg-white overflow-hidden relative" dir="rtl">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none  bg-repeat"></div>

    <div class="container mx-auto flex flex-col md:flex-row items-center justify-center gap-12 px-6 z-10">

        <div class="flex-1 max-w-md w-full p-8 text-right">
            <div class="text-center mb-8">
                <img src="assets/images/authentication/logo-icon.png"
                     class="h-20 w-auto mx-auto mb-2 object-contain"
                     alt="Softé Logo" />
                <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest">Doctor Dashboard</h2>
              
            </div>

          <EditForm Model="@resetModel" OnValidSubmit="HandleResetPassword">
    <div class="bg-gray-50 p-8 rounded-[2rem] shadow-sm border border-gray-100">

        <div class="mb-5">
            <label class="block text-sm font-bold text-gray-600 mb-2 mr-1">@L["كلمة المرور الجديدة"]</label>
            <InputText @bind-Value="resetModel.NewPassword" type="password"
                       class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-100 outline-none transition-all placeholder:text-gray-300"
                       placeholder="********" />
        </div>

        <div class="mb-2">
            <label class="block text-sm font-bold text-gray-600 mb-2 mr-1">@L["تأكيد كلمة المرور"]</label>
            <InputText @bind-Value="resetModel.ConfirmPassword" type="password"
                       class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-100 outline-none transition-all placeholder:text-gray-300"
                       placeholder="********" />
        </div>

        <button type="submit"
                class="w-full mt-8 py-4 bg-black text-white font-black rounded-xl
                shadow-xl transform transition-all duration-150
                hover:bg-gray-900 hover:shadow-2xl
                active:scale-[0.97] active:bg-gray-800 active:shadow-inner
                flex items-center justify-center gap-2 outline-none">
            
            <span class="oi oi-circle-check" aria-hidden="true"></span>
            <span>@L["حفظ كلمة المرور"]</span>
        </button>

    </div>
</EditForm>

        </div>
    <div class="hidden md:flex flex-1 h-full items-center justify-center bg-slate-50/5 relative order-2">
            <div class="w-full h-full p-12 relative z-10">
                <img src="/assets/images/authentication/doctor.png"
                     alt="Verification"
                     class="w-full h-full object-contain drop-shadow-2xl" />
            </div>
        </div>

    </div>
</div>