@page "/auth/verify-code"
@using Microsoft.Extensions.Localization
@layout CustomLayout
@inject AlexApps.Classat.Blazor.Superadmin.Services.JsonLocalizationService L
<div class="min-h-screen flex items-center justify-center bg-white overflow-hidden" dir="rtl">

    <div class="w-full h-screen flex flex-col md:flex-row items-center">

        <div class="flex-1 flex items-center justify-center p-8 md:p-16 bg-white order-1">
            <div class="max-w-md w-full text-center">

                <div class="mb-10">
                    <img src="/assets/images/authentication/logo-icon.png"
                         class="block mx-auto h-16 w-auto object-contain"
                         alt="Logo" />
                    <h2 class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] mt-2">@L["Doctor Dashboard"]</h2>
                </div>

                <div class="mb-8 px-4">
                     @if (!string.IsNullOrEmpty(apiErrorMessage))
{
    <p class="text-red-500 text-xs mt-2 font-bold">@apiErrorMessage</p>
}
                    <h3 class="text-gray-600 text-sm font-bold leading-relaxed">
                        @L["Enter the verification code sent to"]
                        <span class="inline-block" dir="ltr" style="margin: 0 4px;">
                            @MaskEmail(Username)
                        </span>
                    </h3>
                </div>

                <div class="flex justify-center gap-3 mb-10 mt-8" dir="ltr">
                    @for (int i = 0; i < 4; i++)
                    {
                        var index = i;
                        <input type="text"
                               id="otp-@index"
                               maxlength="1"
                               @bind="otpValues[index]"
                               @bind:event="oninput"
                               onkeyup="otpInputFunctions.nextInput(this, @index)"
                               class="otp-input w-14 h-16 text-center text-2xl font-bold bg-gray-50 border border-gray-100 rounded-xl focus:ring-2 focus:ring-blue-100 outline-none transition-all" />
                    }
                </div>

                <button type="button" @onclick="VerifyCode"
                        class="w-full py-4 bg-black text-white font-black rounded-2xl transition-all duration-200
               hover:bg-gray-900 active:scale-[0.98] active:bg-gray-800 mb-6 mt-8 shadow-xl">
                    @L["Login"]
                </button>

                <div class="flex flex-col items-center gap-2">
                    <p class="text-xs text-gray-400">
                        @L["Didn't receive the code?"]
                        <button type="button" @onclick="ResendCode"
                                class="text-blue-600 font-bold hover:underline mx-1 @(IsResendDisabled ? "opacity-50 cursor-not-allowed" : "")"
                                disabled="@IsResendDisabled">
                            @L["Resend"]
                        </button>
                    </p>
                    <span class="text-sm font-mono font-bold text-gray-600 tracking-widest">@TimerDisplay</span>
                </div>

            </div>
        </div>

        <div class="hidden md:flex flex-1 h-full items-center justify-center bg-slate-50/5 relative order-2">
            <div class="w-full h-full p-12 relative z-10">
                <img src="/assets/images/authentication/doctor.png"
                     alt="Verification"
                     class="w-full h-full object-contain drop-shadow-2xl" />
            </div>
            <div class="absolute inset-0 opacity-[0.02] flex items-center justify-center">
                <img src="/assets/images/authentication/logo-icon.png" class="w-1/2 opacity-20" />
            </div>
        </div>

    </div>
</div>
<script>
           window.otpInputFunctions = {
        nextInput: function (currentInput, index) {
            const inputs = document.querySelectorAll('.otp-input');

      
            if (event.key === 'Backspace') {
                if (index > 0 && currentInput.value.length === 0) {
                    inputs[index - 1].focus();
                }
            }

            else if (currentInput.value.length === 1) {
                if (index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            }
        }
    };
</script>