@page "/auth/verify-phone"
@using Microsoft.Extensions.Localization
@layout CustomLayout
@inject AlexApps.Classat.Blazor.Superadmin.Services.JsonLocalizationService L

<div class="min-h-screen flex items-center justify-center bg-white overflow-hidden" dir="rtl">
    <div class="w-full h-screen flex flex-col md:flex-row items-center">

        <div class="flex-1 flex items-center justify-center p-8 md:p-16 bg-white order-1">
            <div class="max-w-md w-full text-center">

                <div class="mb-6">
                    <img src="/assets/images/authentication/logo-icon.png" class="h-16 mx-auto mb-4" />

                    <div class="bg-green-50 w-32 h-32 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-sm">
                        <img src="assets/images/authentication/text.png"
                             class="w-24 h-24 object-contain"
                             alt="Success Icon" />
                    </div>
                </div>

                <div class="mb-8">
                    <h3 class="text-2xl font-black text-slate-800 mb-3">@L["VerifyYourMessages"]</h3>
                    <p class="text-gray-500 text-sm font-bold leading-relaxed">
                        @L["VerificationCodeSentTo"]
                        <span dir="ltr" class="text-blue-600">@MaskPhone(PhoneNumber)</span>
                    </p>
                    @if (!string.IsNullOrEmpty(apiErrorMessage))
                    {
                        <p class="text-red-500 text-xs mt-3 font-bold bg-red-50 p-2 rounded">@apiErrorMessage</p>
                    }
                </div>

                <div class="flex justify-center gap-3 mb-10 mt-8" dir="ltr">
                    @for (int i = 0; i < 4; i++)
                    {
                        var index = i;
                        <input type="text"
                               maxlength="1"
                               id="otp-@index"
                               @bind="otpValues[index]"
                               @bind:event="oninput"
                               onkeyup="otpInputFunctions.nextInput(this, @index, event)"
                               class="otp-input w-14 h-16 text-center text-2xl font-bold bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-50 outline-none transition-all" />
                    }
                </div>

                <button type="button" @onclick="VerifyCode" disabled="@isProcessing"
                        class="w-full mt-12 py-4 bg-black text-white font-black rounded-2xl transition-all hover:bg-gray-900 active:scale-[0.98] mb-6 shadow-xl disabled:bg-gray-400">
                    @if (isProcessing)
                    {
                        <span class="animate-spin h-5 w-5 border-2 border-white border-t-transparent rounded-full inline-block"></span>
                    }
                    else
                    {
                        <span>@L["VerifyCodeBtn"]</span>
                    }
                </button>

                <div class="flex flex-col items-center gap-2">
                    <p class="text-xs text-gray-400 font-bold">
                        @L["DidntReceiveCode"]
                        <button type="button" @onclick="ResendCode"
                                class="text-blue-600 hover:underline mx-1 @(IsResendDisabled ? "opacity-50 cursor-not-allowed" : "")"
                                disabled="@IsResendDisabled">
                            @L["ResendBtn"]
                        </button>
                    </p>
                    <span class="text-sm font-mono font-bold text-slate-600">@TimerDisplay</span>
                </div>
            </div>
        </div>

        <div class="hidden md:flex flex-1 h-full items-center justify-center bg-slate-50/5 relative order-2">
            <div class="w-full h-full p-12 relative z-10">
                <img src="/assets/images/authentication/doctor.png" class="w-full h-full object-contain drop-shadow-2xl" />
            </div>
        </div>

    </div>
</div>

@* إضافة الـ JavaScript في نهاية الملف *@
<script>
    window.otpInputFunctions = {
        nextInput: function (currentInput, index, event) {
            const inputs = document.querySelectorAll('.otp-input');

            // الرجوع للخلف عند الضغط على Backspace
            if (event.key === 'Backspace') {
                if (index > 0 && currentInput.value.length === 0) {
                    inputs[index - 1].focus();
                }
            }
            // الانتقال للأمام عند إدخال رقم
            else if (currentInput.value.length === 1) {
                if (index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            }
        }
    };
</script>